{
	admin off
	servers {
		# Servidor propio: solo redes privadas. En Railway todo el tráfico entra por su borde, cuya IP no es
		# privada: TRUSTED_PROXIES="0.0.0.0/0 ::/0" conserva la IP real del cliente en X-Forwarded-For.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

# SITE_ADDRESS=erp.midominio.com → certificado HTTPS automático (Let's Encrypt).
# SITE_ADDRESS=:80 (o :$PORT en Railway) → HTTP plano detrás de un balanceador que ya termina TLS.
{$SITE_ADDRESS::80} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}
	request_body /api/* {
		max_size 25MB
	}
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}
	handle /health/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
