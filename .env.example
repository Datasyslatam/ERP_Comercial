# Copie a .env y reemplace TODOS los valores marcados CAMBIAR. Nunca suba .env al repositorio.
ENVIRONMENT=production
APP_VERSION=1.0.0

# Base de datos (docker-compose crea el contenedor con estos datos)
POSTGRES_USER=erp
POSTGRES_PASSWORD=CAMBIAR-contraseña-larga-y-aleatoria
POSTGRES_DB=erp
# Para ejecutar el backend fuera de Docker:
DATABASE_URL=postgresql+psycopg://erp:CAMBIAR@localhost:5432/erp
# Solo para pruebas automatizadas (base exclusiva, se borra en cada ejecución):
TEST_DATABASE_URL=postgresql+psycopg://erp:CAMBIAR@localhost:5432/erp_test

# Seguridad: genere con  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR-minimo-32-caracteres
AUTH_MODE=local
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
CORS_ORIGINS=https://erp.midominio.com

# Dominio público: Caddy obtiene el certificado HTTPS automáticamente (puertos 80/443 abiertos)
SITE_ADDRESS=erp.midominio.com

# Facturación electrónica: mientras no haya proveedor contratado se usan adaptadores SANDBOX (sin validez fiscal)
EINVOICE_ADAPTER_CO=sandbox_dian
EINVOICE_ADAPTER_VE=sandbox_seniat

# Observabilidad
SENTRY_DSN=
LOG_LEVEL=INFO

# Respaldos
BACKUP_RETENTION_DAYS=30
BACKUP_HOST_DIR=./backups
WEB_CONCURRENCY=2
